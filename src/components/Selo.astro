---
// Selo tipográfico "CF" em círculo contornado (estilo Slush). Não é o monograma oficial: o logo vetorial
// ainda é pendência, então aqui fica só a sigla na fonte de display.
interface Props {
  class?: string;
  invert?: boolean;
}
const { class: className = "", invert = false } = Astro.props;
---

<span
  class:list={[
    "selo grid size-12 shrink-0 place-items-center rounded-full border font-display text-[1.35rem] font-extrabold leading-none tracking-[0.02em]",
    invert ? "border-paper bg-ink text-paper" : "border-line bg-paper text-ink",
    className,
  ]}
  aria-hidden="true"><span class="translate-y-[0.04em]">CF</span></span
>
